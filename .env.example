# Copy the Transaction pooler URI from Supabase → Connect for Vercel/serverless use.
# Replace its password and URL-encode reserved password characters. Keep server-side only.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require

# Private Storage bucket for artist catalogue submissions
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=catalogue-submissions
